    given-names: Gnaneswara
    orcid: "https://orcid.org/0000-0002-6030-8707"
  - family-names: Bayina
    given-names: Chandhini
    orcid: "https://orcid.org/0009-0002-1359-1762"
    affiliation: "University of Central Missouri, Missouri, United States"
